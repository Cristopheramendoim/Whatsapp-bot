{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile stored privately under the user's UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "WhatsApp-style conversation thread owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "lastPreview": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "subtitle", "lastPreview", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a user's conversation thread, supporting text, audio transcription, attachments, and suggested tasks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "assistant"],
          "maxLength": 16
        },
        "text": {
          "type": "string",
          "maxLength": 8000
        },
        "transcription": {
          "type": "string",
          "maxLength": 8000
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 200
        },
        "attachmentMime": {
          "type": "string",
          "maxLength": 100
        },
        "attachmentSize": {
          "type": "number"
        },
        "attachmentKind": {
          "type": "string",
          "enum": ["image", "audio", "document"],
          "maxLength": 20
        },
        "attachmentDataUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "suggestedTasks": {
          "type": "array"
        },
        "addedTaskTitles": {
          "type": "array"
        },
        "error": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "threadId", "sender", "text", "createdAt", "updatedAt"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Prioritized personal task linked to an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "priority": {
          "type": "string",
          "enum": ["alta", "media", "baixa"],
          "maxLength": 16
        },
        "completed": {
          "type": "boolean"
        },
        "sourceThreadTitle": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "priority", "completed", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile containing PII (email, displayName, photoURL)."
    },
    "/users/{userId}/threads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User-owned conversation threads."
    },
    "/users/{userId}/threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a user-owned conversation thread."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "User-owned prioritized tasks."
    }
  }
}
